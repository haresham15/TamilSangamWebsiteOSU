# OSU Tamil Sangam — Stay in Sangam Email Engine Environment Variables

# Resend API Key (Recommended for automated transactional emails in production)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=

# Sender email identity (Requires verified domain in Resend)
EMAIL_FROM="OSU Tamil Sangam <updates@osutamilsangam.org>"

# Optional Webhook URL (Zapier, Make, Google Sheets, Slack, Mailchimp)
# Will receive payload: { event: "newsletter.subscribed", to: string, subject: string, timestamp: string }
NEWSLETTER_WEBHOOK_URL=

# Note: If no keys are provided, the engine runs in local verified receipt mode,
# recording subscribers to data/subscribers.json and dispatches to data/dispatches.json.

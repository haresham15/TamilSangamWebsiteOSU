# OSU Tamil Sangam — Stay in Sangam Email Engine Environment Variables

# Resend API Key (Recommended for automated transactional emails in production)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=

# Sender email identity (Requires verified domain in Resend)
EMAIL_FROM="OSU Tamil Sangam <tamilsangamosu@gmail.com>"

# Optional Webhook URL (Zapier, Make, Google Sheets, Slack, Mailchimp)
# Will receive payload: { event: "newsletter.subscribed", to: string, subject: string, timestamp: string }
NEWSLETTER_WEBHOOK_URL=

# If no delivery provider is configured, subscriptions are saved but email is not sent.
# Receipts record attempts only and are never reported as delivered.

# Server-only bearer token required for POST/DELETE /api/knowledge.
# Send Authorization: Bearer <token> from trusted administration clients over HTTPS.
# Never expose this as NEXT_PUBLIC_*, put it in browser storage, or commit a real token.
KNOWLEDGE_ADMIN_TOKEN=

# Node.js >=22.13; persistent local directory shared by all workers on one host.
# Defaults to ./data. Production requires a mounted persistent volume (not /tmp).
# SQLite transactions preserve legacy subscribers.json, suggestions.json,
# custom_knowledge.json and dispatches.json; originals remain untouched.
# Ephemeral/serverless deployments need a durable database adapter before deployment.
SANGAM_DATA_DIR=

{
  "name": "Project Aintinai Design Tokens",
  "version": "1.0.0",
  "description": "Deterministic DTCG Three-Tier Design Tokens for OSU Tamil Sangam digital presence.",
  "color": {
    "primitive": {
      "sangam-purple": {
        "$value": "oklch(0.38 0.22 305)",
        "$type": "color",
        "$description": "Official emblem background; rich regal Dravidian royal violet (#4c2472)"
      },
      "sangam-purple-light": {
        "$value": "oklch(0.48 0.24 300)",
        "$type": "color",
        "$description": "Radiant electric violet for hover and active highlights (#6e2dae)"
      },
      "sangam-purple-dark": {
        "$value": "oklch(0.20 0.10 305)",
        "$type": "color",
        "$description": "Deep plum ink for AAA accessible text hierarchy (#250d38)"
      },
      "sangam-mint": {
        "$value": "oklch(0.78 0.16 168)",
        "$type": "color",
        "$description": "Signature mint teal from 3D drop shadow (#55CCA2)"
      },
      "sangam-mint-dark": {
        "$value": "oklch(0.52 0.17 168)",
        "$type": "color",
        "$description": "Deep accessible mint teal for high-contrast borders (#16835f)"
      },
      "sangam-mint-light": {
        "$value": "oklch(0.92 0.06 168)",
        "$type": "color",
        "$description": "Ice mint ambient glow surface (#ccfbf1)"
      },
      "sangam-lilac": {
        "$value": "oklch(0.86 0.09 300)",
        "$type": "color",
        "$description": "Soft lilac from repeating Tamil script watermark (#e9d5ff)"
      },
      "sangam-cream": {
        "$value": "oklch(0.98 0.015 85)",
        "$type": "color",
        "$description": "Warm ivory from TAMIL SANGAM lettering fill (#fffdf9)"
      },
      "sangam-gold": {
        "$value": "oklch(0.82 0.18 85)",
        "$type": "color",
        "$description": "Festive turmeric sun gold for harvest celebration accents (#f59e0b)"
      },
      "sangam-coral": {
        "$value": "oklch(0.62 0.22 25)",
        "$type": "color",
        "$description": "Kumkumam celebration coral for energetic dance accents (#f43f5e)"
      },
      "tinai": {
        "marutham-bronze": {
          "$value": "oklch(0.68 0.16 85)",
          "$type": "color",
          "$description": "Plains & Assembly agricultural bronze"
        },
        "neithal-teal": {
          "$value": "oklch(0.52 0.14 195)",
          "$type": "color",
          "$description": "Seashore & Estuaries deep mayil teal"
        },
        "mullai-green": {
          "$value": "oklch(0.60 0.12 135)",
          "$type": "color",
          "$description": "Forest & Jasmine groves olai green"
        },
        "paalai-terracotta": {
          "$value": "oklch(0.48 0.18 38)",
          "$type": "color",
          "$description": "Sun-drenched earth & journey terracotta"
        },
        "kurinji-violet": {
          "$value": "oklch(0.62 0.18 290)",
          "$type": "color",
          "$description": "High mountain Neelakurinji 12-year bloom violet"
        }
      }
    },
    "semantic": {
      "action": {
        "primary": {
          "$value": "{color.primitive.sangam-purple}",
          "$type": "color",
          "$description": "Primary interactive action color"
        },
        "hover": {
          "$value": "{color.primitive.sangam-purple-light}",
          "$type": "color",
          "$description": "Primary action hover state"
        }
      },
      "surface": {
        "base": {
          "$value": "oklch(0.975 0.015 300)",
          "$type": "color",
          "$description": "Main tinted surface base"
        },
        "raised": {
          "$value": "#ffffff",
          "$type": "color",
          "$description": "Elevated cards and containers"
        },
        "sunken": {
          "$value": "oklch(0.945 0.025 300)",
          "$type": "color",
          "$description": "Sunken wells and input fields"
        },
        "overlay": {
          "$value": "oklch(0.99 0.008 300 / 0.92)",
          "$type": "color",
          "$description": "Backdrop modal and dropdown overlay"
        }
      },
      "border": {
        "subtle": {
          "$value": "oklch(0.38 0.22 305 / 0.12)",
          "$type": "color",
          "$description": "Subtle card stroke"
        },
        "strong": {
          "$value": "oklch(0.38 0.22 305 / 0.28)",
          "$type": "color",
          "$description": "Focused or accented card boundary"
        },
        "mint": {
          "$value": "oklch(0.78 0.16 168 / 0.65)",
          "$type": "color",
          "$description": "3D mint halo border"
        }
      },
      "text": {
        "primary": {
          "$value": "{color.primitive.sangam-purple-dark}",
          "$type": "color",
          "$description": "High-contrast primary typography (AAA)"
        },
        "secondary": {
          "$value": "oklch(0.36 0.09 305)",
          "$type": "color",
          "$description": "Secondary editorial copy"
        },
        "muted": {
          "$value": "oklch(0.55 0.06 305)",
          "$type": "color",
          "$description": "Metadata and helper text"
        }
      }
    },
    "component": {
      "button-primary-bg": {
        "$value": "{color.semantic.action.primary}",
        "$type": "color"
      },
      "button-primary-hover": {
        "$value": "{color.semantic.action.hover}",
        "$type": "color"
      },
      "card-surface-bg": {
        "$value": "{color.semantic.surface.raised}",
        "$type": "color"
      },
      "accent-mint-glow": {
        "$value": "oklch(0.78 0.16 168 / 0.35)",
        "$type": "color"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": {
        "$value": ["Clash Display", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Display headings"
      },
      "body": {
        "$value": ["var(--font-mukta-malar)", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Body copy"
      },
      "tamil": {
        "$value": ["var(--font-mukta-malar)", "serif"],
        "$type": "fontFamily",
        "$description": "Authentic classical Tamil script"
      },
      "mono": {
        "$value": ["JetBrains Mono", "monospace"],
        "$type": "fontFamily",
        "$description": "Metadata and telemetry code"
      }
    },
    "lineHeight": {
      "display": {
        "$value": 1.12,
        "$type": "lineHeight"
      },
      "body": {
        "$value": 1.6,
        "$type": "lineHeight"
      },
      "tamil": {
        "$value": 1.72,
        "$type": "lineHeight",
        "$description": "Extended line-height to eliminate clipping of upper/lower Tamil vowel signs"
      }
    }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" }
  },
  "motion": {
    "spring": {
      "interactive": {
        "stiffness": 350,
        "damping": 28,
        "$type": "motion",
        "$description": "Tactile response for user manipulation (hover, drag, tilt)"
      },
      "tight": {
        "stiffness": 400,
        "damping": 30,
        "$type": "motion",
        "$description": "Snappy response for buttons and pills"
      }
    },
    "tween": {
      "systemEnter": {
        "duration": "0.35s",
        "ease": [0.16, 1, 0.3, 1],
        "$type": "motion",
        "$description": "Predictable cubic bezier for page entrances and modal fades"
      }
    }
  }
}

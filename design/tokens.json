{
  "name": "Project Aintinai Design Tokens",
  "version": "2.0.0",
  "description": "Deterministic DTCG Three-Tier Logo-Derived Design Tokens for OSU Tamil Sangam.",
  "color": {
    "primitive": {
      "bg": {
        "$value": "#140C20",
        "$type": "color",
        "$description": "Deep violet logo ground canvas"
      },
      "bg-subtle": {
        "$value": "#1A1028",
        "$type": "color",
        "$description": "Alternate deep violet canvas"
      },
      "surface": {
        "$value": "#25173B",
        "$type": "color",
        "$description": "Raised card and panel surface"
      },
      "surface-2": {
        "$value": "#352254",
        "$type": "color",
        "$description": "Elevated dialogs, popovers, and secondary surfaces"
      },
      "surface-3": {
        "$value": "#452C6D",
        "$type": "color",
        "$description": "Interactive card hover and active pills"
      },
      "ink": {
        "$value": "#F4F0FA",
        "$type": "color",
        "$description": "Off-white highlights and primary typography"
      },
      "ink-muted": {
        "$value": "#C4B7D7",
        "$type": "color",
        "$description": "Off-white at 70% perceptual luminance for secondary copy"
      },
      "ink-subtle": {
        "$value": "#9B8EB3",
        "$type": "color",
        "$description": "Violet mid subtle helper and caption text"
      },
      "accent": {
        "$value": "#A6F0CF",
        "$type": "color",
        "$description": "Official emblem wordmark signature mint hero accent"
      },
      "accent-hover": {
        "$value": "#7AE7B5",
        "$type": "color",
        "$description": "Mint hover and interactive active glow"
      },
      "accent-dark": {
        "$value": "#2D8A68",
        "$type": "color",
        "$description": "Accessible border and dark badge mint"
      },
      "accent-2": {
        "$value": "#F26BB5",
        "$type": "color",
        "$description": "Chromatic offset shadow pink/magenta accent"
      },
      "accent-2-soft": {
        "$value": "#F8A8D5",
        "$type": "color",
        "$description": "Light pink highlight tint"
      },
      "accent-3": {
        "$value": "#4FD6E0",
        "$type": "color",
        "$description": "Chromatic offset shadow cyan/teal accent"
      },
      "accent-3-soft": {
        "$value": "#8FE7EE",
        "$type": "color",
        "$description": "Light cyan highlight tint"
      },
      "line": {
        "$value": "rgba(125, 96, 166, 0.25)",
        "$type": "color",
        "$description": "Violet mid at low opacity for subtle borders"
      },
      "line-strong": {
        "$value": "rgba(166, 240, 207, 0.35)",
        "$type": "color",
        "$description": "Mint at low opacity for accented borders"
      },
      "sangam-purple": {
        "$value": "oklch(0.38 0.22 305)",
        "$type": "color",
        "$description": "Official emblem background royal violet (#4c2472)"
      },
      "sangam-purple-light": {
        "$value": "oklch(0.48 0.24 300)",
        "$type": "color",
        "$description": "Radiant electric violet for active highlights (#6e2dae)"
      },
      "sangam-purple-dark": {
        "$value": "#140C20",
        "$type": "color",
        "$description": "Deep violet canvas ink"
      },
      "sangam-mint": {
        "$value": "#A6F0CF",
        "$type": "color",
        "$description": "Signature mint teal from logo wordmark"
      },
      "sangam-mint-dark": {
        "$value": "#2D8A68",
        "$type": "color",
        "$description": "Accessible mint teal"
      },
      "sangam-mint-light": {
        "$value": "#C7F7E1",
        "$type": "color",
        "$description": "Ice mint ambient glow surface"
      },
      "sangam-lilac": {
        "$value": "#C4B7D7",
        "$type": "color",
        "$description": "Soft lilac from repeating Tamil script watermark"
      },
      "sangam-cream": {
        "$value": "#F4F0FA",
        "$type": "color",
        "$description": "Off-white highlights"
      },
      "tinai": {
        "marutham-bronze": {
          "$value": "#A6F0CF",
          "$type": "color",
          "$description": "Plains & Assembly agricultural mint accent"
        },
        "neithal-teal": {
          "$value": "#4FD6E0",
          "$type": "color",
          "$description": "Seashore & Estuaries deep cyan"
        },
        "mullai-green": {
          "$value": "#7AE7B5",
          "$type": "color",
          "$description": "Forest & Jasmine groves vibrant mint"
        },
        "paalai-terracotta": {
          "$value": "#F26BB5",
          "$type": "color",
          "$description": "Sun-drenched journey chromatic pink"
        },
        "kurinji-violet": {
          "$value": "#A28FB7",
          "$type": "color",
          "$description": "High mountain Neelakurinji bloom violet"
        }
      }
    },
    "semantic": {
      "action": {
        "primary": {
          "$value": "{color.primitive.accent}",
          "$type": "color",
          "$description": "Primary action button and interactive focal points"
        },
        "hover": {
          "$value": "{color.primitive.accent-hover}",
          "$type": "color",
          "$description": "Primary action hover state"
        }
      },
      "surface": {
        "base": {
          "$value": "{color.primitive.bg}",
          "$type": "color",
          "$description": "Main root page background"
        },
        "raised": {
          "$value": "{color.primitive.surface}",
          "$type": "color",
          "$description": "Elevated cards and containers"
        },
        "sunken": {
          "$value": "{color.primitive.bg-subtle}",
          "$type": "color",
          "$description": "Sunken wells and input fields"
        },
        "overlay": {
          "$value": "rgba(37, 23, 59, 0.92)",
          "$type": "color",
          "$description": "Backdrop modal and dropdown overlay"
        }
      },
      "border": {
        "subtle": {
          "$value": "{color.primitive.line}",
          "$type": "color",
          "$description": "Subtle card stroke"
        },
        "strong": {
          "$value": "{color.primitive.line-strong}",
          "$type": "color",
          "$description": "Focused or accented card boundary"
        },
        "mint": {
          "$value": "rgba(166, 240, 207, 0.5)",
          "$type": "color",
          "$description": "Mint halo border"
        }
      },
      "text": {
        "primary": {
          "$value": "{color.primitive.ink}",
          "$type": "color",
          "$description": "High-contrast primary typography (AAA)"
        },
        "secondary": {
          "$value": "{color.primitive.ink-muted}",
          "$type": "color",
          "$description": "Secondary editorial copy"
        },
        "muted": {
          "$value": "{color.primitive.ink-subtle}",
          "$type": "color",
          "$description": "Muted captions and footnotes"
        }
      }
    },
    "component": {
      "button": {
        "primary": {
          "bg": { "$value": "{color.semantic.action.primary}", "$type": "color" },
          "text": { "$value": "{color.primitive.bg}", "$type": "color" },
          "hover-bg": { "$value": "{color.semantic.action.hover}", "$type": "color" }
        },
        "secondary": {
          "bg": { "$value": "{color.primitive.surface}", "$type": "color" },
          "text": { "$value": "{color.primitive.ink}", "$type": "color" },
          "border": { "$value": "{color.primitive.line-strong}", "$type": "color" },
          "hover-bg": { "$value": "{color.primitive.surface-2}", "$type": "color" }
        },
        "ghost": {
          "text": { "$value": "{color.primitive.accent}", "$type": "color" },
          "hover-bg": { "$value": "rgba(166, 240, 207, 0.12)", "$type": "color" }
        }
      },
      "card": {
        "bg": { "$value": "{color.semantic.surface.raised}", "$type": "color" },
        "border": { "$value": "{color.semantic.border.subtle}", "$type": "color" },
        "hover-border": { "$value": "{color.semantic.border.strong}", "$type": "color" }
      },
      "input": {
        "bg": { "$value": "{color.semantic.surface.sunken}", "$type": "color" },
        "text": { "$value": "{color.semantic.text.primary}", "$type": "color" },
        "placeholder": { "$value": "{color.semantic.text.muted}", "$type": "color" },
        "border": { "$value": "{color.semantic.border.subtle}", "$type": "color" },
        "focus-border": { "$value": "{color.primitive.accent-3}", "$type": "color" }
      }
    }
  }
}

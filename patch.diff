+/**
+ * Safely serialize JSON-LD to prevent XSS attacks.
+ * By escaping the '<' character, we prevent breaking out of the <script> tag.
+ */
+function safeJsonLd(data: any): string {
+  return JSON.stringify(data).replace(/</g, '\\u003c');
+}
